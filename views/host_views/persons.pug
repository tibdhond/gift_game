extends ../layout

block content
    .container
        h3 Ga naar #{ip}:3000 om te beginnen
        .row.row-marg
            each person in persons
                .col-sm-4
                    .card.card-shadow.card-marg
                        .card-body.text-center
                            i.material-icons.md-icon-48 person
                            h5.card-title #{person.name}
                            form(method='POST' action='/people/delete/people')
                                button.btn.btn-danger(type='submit' style="float:right", name="person", value=person) Verwijder
            else
                p Er zijn nog geen mensen.

        form(method='POST' action='/start')
            .btn-group-toggle(data-toggle='buttons', style="float:right")
                label.btn.btn-secondary
                    input#rTrue(type='checkbox', name='rTrue' autocomplete='off', style="float:right")
                    |  Speel verder

            button.btn.btn-primary(type='submit' style="float:right") Start spel

    script.
        let HOST = `${location.origin.replace(/^http/, 'ws')}/host`;
        console.log(HOST);
        let ws = new WebSocket(HOST);

        ws.onmessage = function (msg) {
            console.log(msg.data);
            if (msg.data === "new person") {
                ws.close();
                window.location.reload();
            }
        }
