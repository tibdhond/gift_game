extends ../layout

block content
    .container
        h3 Ga naar #{ip} om te beginnen
        .row.row-marg
            each person in persons
                .col-sm-4
                    .card.card-shadow.card-marg
                        .card-body.text-center
                            i.material-icons.md-icon-48 person
                            h5.card-title #{person.name}
                            form(method='POST' action='/people/delete/people')
                                button.btn.btn-danger(type='submit' style="float:right", name="person", value=person.name) Verwijder
            else
                p Er zijn nog geen mensen.

        form(method='POST' action='/start')
            .form-row
                .btn-group-toggle(data-toggle='buttons', style="float:right")
                    label.btn.btn-white
                        input#rm_pc(type='checkbox', name='rm_pc' autocomplete='off', style="float:right")
                        |  Verwijder spelers
                .btn-group-toggle(data-toggle='buttons', style="float:right")
                    label.btn.btn-white.active
                        input#self_vote(type='checkbox', name='self_vote' autocomplete='off', style="float:right", checked='')
                        |  Zelf stem
                .btn-group-toggle(data-toggle='buttons', style="float:right")
                    label.btn.btn-white
                        input#load(type='checkbox', name='load' autocomplete='off', style="float:right")
                        |  Speel verder

            button.btn.btn-primary(type='submit' style="float:right") Start spel

    script.
        let HOST = `${location.origin.replace(/^http/, 'ws')}/host`;
        console.log(HOST);
        let ws = new WebSocket(HOST);

        ws.onmessage = function (msg) {
            console.log(msg.data);
            if (msg.data === "new person") {
                // ws.close();
                window.location.reload();
            }
        }
