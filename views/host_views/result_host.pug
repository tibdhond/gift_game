extends ../layout

block content
    .container
        h1(style="color:black")= "Einduitslag"
        canvas#barChart

block script
    script.
        //bar
        let ctxB = document.getElementById("barChart").getContext('2d');
        let names = [];
        let votes = [];
        let my_votes = [];
        let colors1 = [];
        let colors2 = [];
        let colors3 = [];
        let colors4 = [];
        const gradient = -50
        for(person of JSON.parse('!{JSON.stringify(people)}')) {
            names.push(person.name);
            votes.push(person.right);
            my_votes.push(person.my_votes);
            let temp = Math.floor(Math.random() * 255);
            let color1 = 'rgba(' + temp;
            let color2 = 'rgba(' + temp;
            let color3 = `rgba(${temp * (100 + gradient) / 100}`;
            let color4 = `rgba(${temp * (100 + gradient) / 100}`;
            temp = Math.floor(Math.random() * 255);
            color1 += ", " + temp;
            color2 += ", " + temp;
            color3 += `, ${temp * (100 + gradient) / 100}`;
            color4 += `, ${temp * (100 + gradient) / 100}`;
            temp = Math.floor(Math.random() * 255);
            color1 += ", " + temp + ", 0.2)";
            color2 += ", " + temp + ", 1)";
            color3 += `, ${temp * (100 + gradient) / 100}, 0.2`;
            color4 += `, ${temp * (100 + gradient) / 100}, 1`;

            colors1.push(color1);
            colors2.push(color2);
            colors3.push(color3);
            colors4.push(color4)
            console.log(colors3);
        }
        let myBarChart = new Chart(ctxB, {
            type: 'bar',
            data: {
                labels: names,
                datasets: [
                    {
                        label: '# juiste antwoorden',
                        data: votes,
                        backgroundColor: colors3,
                        borderColor: colors4,
                        borderWidth: 1
                    },
                    {
                        label: '# zelf stemmen',
                        data: my_votes,
                        backgroundColor: colors1,
                        borderColor: colors2,
                        borderWidth: 1
                    }]
            },
            options: {
                scales: {
                    yAxes: [{
                        stacked: true,
                        ticks: {
                            beginAtZero: true
                        }
                    }],
                    xAxes: [{
                        stacked: true
                    }]
                }
            }
        });
