extends ../layout

block content
    .container
        h1(style="color:black")= "Einduitslag"
        canvas#barChart

block script
    script.
        //bar
        let ctxB = document.getElementById("barChart").getContext('2d');
        let names = [];
        let votes = [];
        let my_votes = [];
        let colors1 = [];
        let colors2 = [];
        let colors3 = [];
        let colors4 = [];
        const gradient = -50
        for(person of JSON.parse('!{JSON.stringify(people)}')) {
            names.push(person.name);
            votes.push(person.right);
            my_votes.push(person.my_votes);
            colors1.push('rgba(200, 0, 0, 0)');
            colors2.push('rgba(255, 0, 0, 0)');
            colors3.push('rgba(0, 200, 0, 0)');
            colors4.push('rgba(0, 255, 0, 0)');
            console.log(colors3);
        }
        let myBarChart = new Chart(ctxB, {
            type: 'bar',
            data: {
                labels: names,
                datasets: [
                    {
                        label: '# juiste antwoorden',
                        data: votes,
                        backgroundColor: colors3,
                        borderColor: colors4,
                        borderWidth: 1
                    },
                    {
                        label: '# zelf stemmen',
                        data: my_votes,
                        backgroundColor: colors1,
                        borderColor: colors2,
                        borderWidth: 1
                    }]
            },
            options: {
                scales: {
                    yAxes: [{
                        stacked: true,
                        ticks: {
                            beginAtZero: true
                        }
                    }],
                    xAxes: [{
                        stacked: true
                    }]
                }
            }
        });
