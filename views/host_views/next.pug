extends ../layout

block content
    .container#container
        h1 Volgende cadeau
        br
        form(method='POST' action='/gift')
            .form-row
                .form-group.col-md-6#bqlk
                    .field
                        if complete
                            h4 #{gift}
                        else
                            input#title.form-control(type='text', name='gift', placeholder="")
            .form-row
                .div.knoppebn
                    if complete
                        .btn-group-toggle(data-toggle='buttons' style="float:right")
                            label#left.btn.btn-secondary.active
                                input#rTrue(type='checkbox', name='rTrue' autocomplete='off', style="float:right")
                                |  Willeukeurig cadeau
                    else
                        .btn-group-toggle(data-toggle='buttons')
                            label.btn.btn-white
                                input#rTrue(type='checkbox', name='rTrue' autocomplete='off')
                                |  Willeukeurig cadeau

                    button.btn.btn-primary(type='submit') Volgende stemronde
