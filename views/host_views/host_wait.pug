extends ../layout

block content
    .container
        h1(style="color:black")= "Mensen zijn aan het stemmen voor: " + gift
        h2 #{ratio}
        .progress
            .progress-bar.progress-bar-striped.progress-bar-animated(role='progressbar' aria-valuenow=voted aria-valuemin=0 aria-valuemax=length style='width:'+ratio)
                | #{ratio}

        br
        form(method='POST' action='/reset')
            button.btn.btn-danger(type='submit' style="float:right", name="person", value=person) Reset
    script.
        setTimeout(function () {
            window.location.reload(1);
        }, 5000);