extends layout

block content

block script
    script.
        let HOST = `${location.origin.replace(/^http/, 'ws')}/client`;
        console.log(HOST);
        let ws = new WebSocket(HOST);

        ws.onmessage = function (msg) {
            console.log(msg.data);
            if (msg.data === "finished") {
                // ws.close();
                window.location.reload();
            }
        }

        while (true) {
            setTimeout(() => {
                ws.send('alive');
            }, 5000);
        }

