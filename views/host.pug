extends layout

block content

block script
    script.
        let HOST = `${location.origin.replace(/^http/, 'ws')}/host`;
        console.log(HOST);
        let ws = new WebSocket(HOST);

        ws.onmessage = function (msg) {
            console.log(msg.data);
            if (msg.data === "finished") {
                ws.close();
                window.location.reload();
            }
        }
