extends layout

block content
    .container.card-container
        .row
            .col-sm-8.offset-sm-2
                .card
                    .card-body
                        h2(style="text-align:center")="Login"

                        form(method='POST' action='/login')
                            .form-row
                                .form-group.col-md-6
                                    .field
                                        label() Naam
                                        input#title.form-control(type='text', name='Name', placeholder=nick, required='true')
                            button.btn.btn-primary(type='submit' style="float:right") Submit

                        if taken
                            h5.text-danger Naam al in gebruik. Gelieve een andere naam te kiezen.