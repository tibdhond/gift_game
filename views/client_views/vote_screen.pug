extends ../client

block content
    .container
        h1(style="color:black")= "Breng je stem uit voor: " + gift
        .row.row-marg

            each person in persons
                if person.notcurrent && (person.playing || !rm_pc)
                    .col-sm-4
                        .card.card-shadow.card-marg
                            .card-body.text-center
                                i.material-icons.md-icon-48 person
                                h5.card-title #{person.name}
                                form(method='POST' action='/vote')
                                    button.btn.btn-primary(type='submit' style="float:right", name="person", value=person.name) Stem
                else if !person.notcurrent
                    .col-sm-4
                        .card.card-shadow.card-marg
                            .card-body.text-center
                                i.material-icons.md-icon-48 person
                                h5.card-title #{person.name}
                                form(method='POST' action='/vote')
                                    button.btn.btn-primary(type="submit", name="person",
                                        value="Mijn cadeau", style="width: fit-content; float:right") Mijn cadeau
