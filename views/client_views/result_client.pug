extends ../client

block content
    table.table.table-striped
        thead
            tr
                th(scope='col') Ronde
                th(scope='col') Cadeau
                th(scope='col') Jouw antwoord
                th(scope='col') Juiste antwoord
        tbody
            each gift, i in rounds
                if person.rounds[i] === "Mijn cadeau"
                    tr.bg-info
                        th(scope='row') #{i}
                        td #{gift.description}
                        td #{person.rounds[i]}
                        td #{gift.owner}
                else if person.rounds[i] === gift.owner
                    tr.bg-success
                        th(scope='row') #{i}
                        td #{gift.description}
                        td #{person.rounds[i]}
                        td #{gift.owner}
                else
                    tr.bg-danger
                        th(scope='row') #{i}
                        td #{gift.description}
                        td #{person.rounds[i]}
                        td #{gift.owner}
